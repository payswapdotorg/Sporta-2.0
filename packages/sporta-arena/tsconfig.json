{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025"],
    // app/adapters 层使用 node:crypto（node 内建，无新依赖）；与 packages/services
    // 相同，显式声明 node 类型让 hoisted 的 @types/node 对本包可见。
    "types": ["node"]
  },
  "include": ["src"],
  "references": [{ "path": "../sporta-contracts" }]
}
